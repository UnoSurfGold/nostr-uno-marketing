---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] mt-16">
  <div class="mx-auto max-w-6xl px-6 py-10 grid gap-8 md:grid-cols-4 text-sm">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="w-6 h-6 rounded-full grid place-items-center" style="background: var(--identity-color); color: var(--primary-foreground);">
          <span class="text-[11px] font-bold leading-none">U</span>
        </span>
        Nostr Uno
      </div>
      <p class="mt-3 text-[var(--muted-foreground)] max-w-sm">
        One seed, many selves. Cryptographic identity that's actually usable.
      </p>
    </div>
    <div>
      <h4 class="text-[var(--foreground)] font-medium mb-3">Product</h4>
      <ul class="space-y-2 text-[var(--muted-foreground)]">
        <li><a href="/why-uno" class="hover:text-[var(--identity-color)]">Why Uno</a></li>
        <li><a href="/apps" class="hover:text-[var(--identity-color)]">Apps</a></li>
        <li><a href="https://nostr.uno" class="hover:text-[var(--identity-color)]">Open Uno</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[var(--foreground)] font-medium mb-3">Resources</h4>
      <ul class="space-y-2 text-[var(--muted-foreground)]">
        <li><a href="/developers" class="hover:text-[var(--identity-color)]">Developers</a></li>
        <li><a href="/privacy" class="hover:text-[var(--identity-color)]">Privacy</a></li>
        <li><a href="/press" class="hover:text-[var(--identity-color)]">Press</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-6 pb-8 text-xs text-[var(--muted-foreground)] flex flex-col md:flex-row gap-2 md:justify-between">
    <span>&copy; {year} Nostr Uno. MIT-licensed.</span>
    <span>Built on Nostr. Your keys, your selves.</span>
  </div>
</footer>
