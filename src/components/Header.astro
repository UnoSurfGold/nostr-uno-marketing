---
const navItems = [
  { href: '/why-uno', label: 'Why Uno' },
  { href: '/apps', label: 'Apps' },
  { href: '/developers', label: 'Developers' },
  { href: '/press', label: 'Press' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30 backdrop-blur-md bg-[var(--background)]/80 border-b border-[var(--border)]">
  <div class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="w-7 h-7 rounded-full grid place-items-center" style="background: var(--identity-color); color: var(--primary-foreground);">
        <span class="text-[13px] font-bold leading-none">U</span>
      </span>
      <span>Nostr&nbsp;Uno</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm">
      {navItems.map((item) => {
        const active = pathname === item.href;
        return (
          <a
            href={item.href}
            class:list={['transition-colors', active ? 'text-[var(--identity-color)]' : 'text-[var(--muted-foreground)] hover:text-[var(--foreground)]']}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <a href="https://nostr.uno" class="btn-primary text-sm" data-cta="open-uno">
      Open Uno
    </a>
  </div>
</header>
